# ============================================================
# SATMAT Backend — PRODUCTION env for Hostinger KVM (PM2 + Node + SQLite)
# ============================================================
# Usage on the server:
#   1. copy this file:  cp .env.production.example .env
#   2. fill the values marked <CHANGE>, then run:  bash scripts/deploy.sh
# NEVER commit the real .env.

################################################################
# APPLICATION
################################################################
NODE_ENV=production
PORT=8080
# Public URL of the frontend (used for redirects/links)
APP_URL="https://<CHANGE:your-domain.com>"
# Comma-separated allowed browser origins (frontend domains). NO "*" in prod.
CORS_ORIGINS="https://<CHANGE:your-domain.com>,https://<CHANGE:admin.your-domain.com>,https://<CHANGE:website.your-domain.com>"
# Swagger docs — keep false on a public server
ENABLE_SWAGGER=false

################################################################
# DATABASE (SQLite file)
################################################################
# Use an ABSOLUTE path OUTSIDE the app folder so redeploys never wipe the DB.
# Create the folder first:  sudo mkdir -p /opt/satmat/data
DATABASE_URL="file:/opt/satmat/data/satmat.db"

################################################################
# AUTH (JWT) — REQUIRED, must be >=32 chars in production
################################################################
# Generate each with:  openssl rand -base64 48   (placeholder below fails the
# startup check on purpose — the app refuses to boot with it)
JWT_SECRET="change-me-run-openssl-rand-base64-48"
JWT_REFRESH_SECRET="change-me-run-openssl-rand-base64-48"
ACCESS_TOKEN_TTL=900
REFRESH_TOKEN_TTL=2592000
BCRYPT_ROUNDS=10
# Seed password for the SUPER_ADMIN account (>=8 chars). REQUIRED in production
# (seed fails fast while empty).
ADMIN_PASSWORD=""

################################################################
# REDIS (optional for a single PM2 instance)
################################################################
# Not required when running one instance (falls back to in-memory cache).
# Set it if you restart often and want OTP/idempotency to survive restarts.
# REDIS_URL="redis://127.0.0.1:6379"

################################################################
# PAYMENTS
################################################################
# mock | razorpay
PAYMENT_PROVIDER=mock
# NEVER true with real users (credits money without payment).
MANUAL_PAYMENTS=false
PAYMENT_KEY_ID=
PAYMENT_KEY_SECRET=
PAYMENT_WEBHOOK_SECRET=
PAYOUT_KEY_ID=
PAYOUT_KEY_SECRET=

################################################################
# SMS / OTP   (mock | msg91 | twilio)
################################################################
SMS_PROVIDER=mock
MSG91_AUTH_KEY=
SMS_SENDER_ID=SATMAT
SMS_TEMPLATE_ID=
TWILIO_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

################################################################
# PUSH   (mock | fcm)
################################################################
PUSH_PROVIDER=mock
FCM_SERVER_KEY=
FCM_PROJECT_ID=
FCM_SERVICE_ACCOUNT_JSON=

################################################################
# MONITORING
################################################################
SENTRY_DSN=

################################################################
# SCRAPER (live results)
################################################################
SOURCE_ADAPTER=satmat-web
SCRAPE_ENABLED=true
SCRAPE_INTERVAL_MS=180000
SCRAPE_WINDOW_DAYS=14
SCRAPE_SNAPSHOT_INTERVAL_MS=45000
SCRAPE_BACKFILL_FROM=2019-01-01
SCRAPE_BACKFILL_LOOKBACK_DAYS=90
SCRAPE_AUTO_CREATE_RESULT_MARKETS=false
SCRAPE_PROXY_URL=
SCRAPE_FETCH_CONCURRENCY=5
SCRAPE_MARKET_URLS={}

################################################################
# RATE LIMITS
################################################################
THROTTLE_TTL=60000
THROTTLE_LIMIT=60
