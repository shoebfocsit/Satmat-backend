# Copy to .env and fill values. NEVER commit .env (contains secrets).
# ============================================================
# SATMAT Backend — Environment template (SQLite, no external DB)
# ============================================================
# Local dev quick start:
#   cp .env.example .env
#   npx prisma migrate deploy && npm run db:seed && npm run start:dev
# Production (Hostinger KVM): use .env.production.example instead.

################################################################
# APPLICATION
################################################################
NODE_ENV=development
PORT=8080
APP_URL="http://localhost:3000"
CORS_ORIGINS="http://localhost:3000,http://localhost:5173,http://localhost:5174"
ENABLE_SWAGGER=true

################################################################
# DATABASE (SQLite file — no server, no credentials)
################################################################
# Dev: path is relative to prisma/schema.prisma -> backend/prisma/dev.db
DATABASE_URL="file:./dev.db"
# Prod (absolute path OUTSIDE the app dir so redeploys never wipe it):
# DATABASE_URL="file:/opt/satmat/data/satmat.db"

################################################################
# AUTH (JWT) — REQUIRED, must be >=32 chars
################################################################
# Generate each with:  openssl rand -base64 48
JWT_SECRET="change-me-access-secret-at-least-32-chars-long"
JWT_REFRESH_SECRET="change-me-refresh-secret-at-least-32-chars-long"
ACCESS_TOKEN_TTL=900
REFRESH_TOKEN_TTL=2592000
BCRYPT_ROUNDS=10
# SUPER_ADMIN is seeded with phone +919527194409 (see prisma/seed.ts).
# This value IS the admin login password. REQUIRED in production (>=8 chars).
# Dev: if left empty, defaults to 'admin123'.
ADMIN_PASSWORD=

################################################################
# GEMINI AI (optional — AI support chat)
################################################################
GEMINI_API_KEY=

################################################################
# PAYMENTS (mock | razorpay)
################################################################
PAYMENT_PROVIDER=mock
# NEVER true with real users (credits money without payment).
MANUAL_PAYMENTS=false
PAYMENT_KEY_ID=
PAYMENT_KEY_SECRET=
PAYMENT_WEBHOOK_SECRET=
PAYOUT_KEY_ID=
PAYOUT_KEY_SECRET=

################################################################
# SMS / OTP (mock | msg91 | twilio)
################################################################
SMS_PROVIDER=mock
MSG91_AUTH_KEY=
SMS_SENDER_ID=SATMAT
SMS_TEMPLATE_ID=
TWILIO_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

################################################################
# PUSH (mock | fcm)
################################################################
PUSH_PROVIDER=mock
FCM_SERVER_KEY=
FCM_PROJECT_ID=
FCM_SERVICE_ACCOUNT_JSON=

################################################################
# MONITORING
################################################################
SENTRY_DSN=

################################################################
# REDIS (optional for a single PM2 instance — falls back to in-memory)
################################################################
# REDIS_URL="redis://127.0.0.1:6379"

################################################################
# SCRAPER (live results from satmat-web adapter)
################################################################
SOURCE_ADAPTER=satmat-web
SCRAPE_ENABLED=false
SCRAPE_INTERVAL_MS=180000
SCRAPE_WINDOW_DAYS=14
SCRAPE_SNAPSHOT_INTERVAL_MS=45000
SCRAPE_BACKFILL_FROM=2019-01-01
SCRAPE_BACKFILL_LOOKBACK_DAYS=90
SCRAPE_AUTO_CREATE_RESULT_MARKETS=false
SCRAPE_PROXY_URL=
SCRAPE_FETCH_CONCURRENCY=5
SCRAPE_MARKET_URLS={}

################################################################
# RATE LIMITS
################################################################
THROTTLE_TTL=60000
THROTTLE_LIMIT=60
