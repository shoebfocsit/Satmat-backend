# Copy to .env and fill values. NEVER commit .env.
# ============================================================
# SATMAT Production Environment Configuration
# ============================================================

################################################################
# APPLICATION
################################################################
NODE_ENV=development
PORT=8080
APP_URL="https://web-h3jw711gk-shashank-wagh-s-projects.vercel.app"
CORS_ORIGINS="http://localhost:3000,http://localhost:5173,https://web-h3jw711gk-shashank-wagh-s-projects.vercel.app,https://satmat-web.onrender.com"
ENABLE_SWAGGER=true

################################################################
# DATABASE (Supabase Postgres — production)
################################################################
# Transaction-mode pooler (for runtime) + DIRECT_URL (session-mode, for migrations)
# Add connection_limit & pool_timeout to reduce first-query latency after idle:
#   ?pgbouncer=true&connection_limit=10&pool_timeout=10&connect_timeout=10
# Keep pooler in same region as Render backend (e.g. ap-southeast-2 if backend is in Singapore)
# to save 100-200ms per query vs cross-region (e.g. Render Oregon -> Sydney).
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-ap-southeast-2.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=10&pool_timeout=10"
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-0-ap-southeast-2.pooler.supabase.com:5432/postgres"

################################################################
# SUPABASE (project-specific keys)
################################################################
SUPABASE_URL="https://<project-ref>.supabase.co"
SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_SECRET_KEY="sb_secret_..."
SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."

################################################################
# REDIS (required for production multi-instance deployments)
################################################################
# Redis URL for distributed cache: OTP storage, idempotency keys, rate limiting, refresh tokens.
# REQUIRED in production (backend refuses to boot without it). Must be redis:// or rediss://
# (NOT the Upstash REST https URL). For Upstash use the full TLS connection string from
# the "Connect > REDIS (TLS/0)" tab, e.g.:
#   rediss://default:<PASSWORD>@<instance>.upstash.io:6379
# Set the real value as the REDIS_URL env var in your host (Render dashboard), NEVER commit it.
REDIS_URL="redis://localhost:6379"

################################################################
# AUTH (JWT)
################################################################
# Must be >=32 characters in production. Generate with: openssl rand -base64 32
JWT_SECRET="change-me-access-secret-must-be-32-chars-long-in-prod"
JWT_REFRESH_SECRET="change-me-refresh-secret-must-be-32-chars-long-in-prod"
ACCESS_TOKEN_TTL=900          # seconds (15 min)
REFRESH_TOKEN_TTL=2592000     # seconds (30 days)
# Bcrypt cost factor: 10 = 80ms/hash (secure default), 8 = 19ms/hash (fast, OK for free tier)
# Set to 8 if Render free-tier CPU makes registration feel sluggish; 10 is recommended for paid tiers.
BCRYPT_ROUNDS=10
# DEV ONLY: Admin seed password (set in production, remove fallback in seed.ts)
ADMIN_PASSWORD=

################################################################
# GEMINI AI
################################################################
GEMINI_API_KEY=""

################################################################
# PAYMENTS (Razorpay)
################################################################
# Provider: mock | razorpay
PAYMENT_PROVIDER=mock
# TEST MODE ONLY: "true" = deposits credit + withdrawals complete instantly
# with no gateway (manual testing). NEVER enable with real users — money
# would move without payment. Delete/false before going live with Razorpay.
MANUAL_PAYMENTS=false
# Razorpay keys (required when PAYMENT_PROVIDER=razorpay)
PAYMENT_KEY_ID=
PAYMENT_KEY_SECRET=
PAYMENT_WEBHOOK_SECRET=
# Payout keys (optional, for withdrawals)
PAYOUT_KEY_ID=
PAYOUT_KEY_SECRET=

################################################################
# SMS / OTP (MSG91 or Twilio)
################################################################
# Provider: mock | msg91 | twilio
SMS_PROVIDER=mock
# MSG91 (India)
MSG91_AUTH_KEY=
SMS_SENDER_ID=SATMAT
SMS_TEMPLATE_ID=
# Twilio (Global)
TWILIO_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

################################################################
# PUSH NOTIFICATIONS (Firebase Cloud Messaging)
################################################################
# Provider: mock | fcm
PUSH_PROVIDER=mock
# FCM Legacy server key (optional if using service account)
FCM_SERVER_KEY=
# FCM Project ID
FCM_PROJECT_ID=
# Firebase Admin SDK service account JSON (single-line, escaped)
# Generate from Firebase Console > Project Settings > Service Accounts > Generate New Private Key
FCM_SERVICE_ACCOUNT_JSON=

################################################################
# MONITORING (Sentry)
################################################################
SENTRY_DSN=

################################################################
# ANALYTICS (Google Analytics / GA4)
################################################################
NEXT_PUBLIC_GA_ID=

################################################################
# SCRAPER (live results from sattamatkavip.in — panel charts + homepage)
################################################################
# Adapter: satmat-web (real scraper). No sample/mock data is used anywhere.
SOURCE_ADAPTER=satmat-web
SCRAPE_ENABLED=true
# 3 min: declare-to-app latency for live users. Homepage snapshot (today's
# declares + lucky numbers) rides every cycle in ~1s; panels backfill after.
SCRAPE_INTERVAL_MS=180000
SCRAPE_WINDOW_DAYS=14
# Fast lane: homepage snapshot (today's declares + lucky numbers) refreshes
# on its own cadence so a global release lands in-app within ~a minute,
# independent of the heavy 14-page panel cycle. Min 15000ms (code-enforced).
SCRAPE_SNAPSHOT_INTERVAL_MS=45000
# Deep-history backfill: provider panel pages hold FULL history (~2019+) in a
# single fetch. On boot, markets whose oldest stored row is newer than
# LOOKBACK days get one full fetch (FROM→today) so charts match the source
# site; steady cycles stay on the small rolling window afterwards. Runs once
# per database lifetime (skipped when already deep). Force via
# POST /admin/scrape/backfill.
SCRAPE_BACKFILL_FROM=2019-01-01
SCRAPE_BACKFILL_LOOKBACK_DAYS=90
SCRAPE_DELAY_MS=0
SCRAPE_TIMEOUT_MS=15000
SCRAPE_AUTO_CREATE_RESULT_MARKETS=false
# Optional HTTP/HTTPS proxy URL (e.g. http://user:pass@host:port). Routes
# sattamatkakgf.com market fetches through the proxy's exit IP. Required to reach
# Cloudflare-protected providers (diamond / prabhat / kalyan-morning) when Render's
# datacenter IP is challenged. Empty => direct fetch.
#
# SMART ROUTING: Only sattamatkakgf.com markets are proxied. sattaindianmatka.com
# markets always go direct, even when proxy is set.
#
# To get a proxy:
#   1. Sign up for a residential proxy service (BrightData, Smartproxy, IPRoyal, etc.)
#   2. Get your proxy URL: http://user:pass@host:port
#   3. Set it in Render dashboard as SCRAPE_PROXY_URL
#   4. Verify with: GET /admin/scrape/proxy-check (admin only)
#
# Retry: Each failed fetch retries up to 2 times with exponential backoff.
SCRAPE_PROXY_URL=
# Bounded parallelism for fetching provider panel charts per cycle (1-10).
# Keeps cycle time well under SCRAPE_INTERVAL_MS even with many markets.
SCRAPE_FETCH_CONCURRENCY=5
# Market->URL overrides (JSON). Empty => use built-in defaults. By default all
# 14 live markets are scraped from sattamatkavip.in panel charts (see
# satmat-web.adapter.ts) plus the homepage live snapshot (today's declares
# + lucky numbers). Kalyan primary is sattaindianmatka.com (VIP page stale).
SCRAPE_MARKET_URLS={}

################################################################
# RATE LIMITS
################################################################
THROTTLE_TTL=60000
THROTTLE_LIMIT=60